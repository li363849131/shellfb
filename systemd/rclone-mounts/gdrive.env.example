# rclone-mount@gdrive1 configuration.
# After editing, run: systemctl daemon-reload && systemctl restart rclone-mount@gdrive1

# The remote name as defined in /root/.config/rclone/rclone.conf, followed by
# the path within that remote. Format: remotename:/path  (or remotename: for root).
REMOTE=gd1:/

# Where to mount it — MUST be under /root so both the preview panel and the
# FileBrowser (网盘) can traverse it. The preview panel's transfer handler is
# jailed to /root, and FileBrowser's Root is /root.
MOUNTPOINT=/root/gdrive1

# Cache directory for VFS layer (local disk). This can grow to VFS_CACHE_MAX_SIZE.
CACHE_DIR=/var/cache/rclone/gdrive1

# Cache mode. "full" = cache reads & writes, needed for random access (preview/edit).
# "writes" = only cache new writes. "off" = no cache (slow for large files).
VFS_CACHE_MODE=full

# Max disk space for this mount's cache. 2G per mount = 4G total for two drives.
# Server has 18G free; raise if you need more.
VFS_CACHE_MAX_SIZE=2G

# Evict cached objects not accessed in this time. Default 1h.
VFS_CACHE_MAX_AGE=2h

# How long rclone caches directory listings before re-polling the remote.
DIR_CACHE_TIME=30s

# How often rclone polls Drive for remote changes (new files uploaded elsewhere).
# Must be < DIR_CACHE_TIME. 0 = disable polling.
POLL_INTERVAL=15s

# Google Drive API transactions per second. Default 10. Raise cautiously; Drive
# quotas are per-user and shared across all rclone operations.
TPSLIMIT=10
TPSLIMIT_BURST=1

# Logs go here. Rotate manually or via logrotate (systemd doesn't rotate app logs).
LOG_FILE=/var/log/rclone/gdrive1.log
LOG_LEVEL=INFO

# Extra flags appended to the mount command. Space-separated.
# Examples: --read-only  --drive-acknowledge-abuse  --transfers 4
EXTRA_FLAGS=
