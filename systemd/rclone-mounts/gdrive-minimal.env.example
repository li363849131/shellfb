# rclone-mount@gdrive2 configuration.
# After editing, run: systemctl daemon-reload && systemctl restart rclone-mount@gdrive2

REMOTE=gd2:/
MOUNTPOINT=/root/gdrive2
CACHE_DIR=/var/cache/rclone/gdrive2
VFS_CACHE_MODE=full
VFS_CACHE_MAX_SIZE=2G
VFS_CACHE_MAX_AGE=2h
DIR_CACHE_TIME=30s
POLL_INTERVAL=15s
TPSLIMIT=10
TPSLIMIT_BURST=1
LOG_FILE=/var/log/rclone/gdrive2.log
LOG_LEVEL=INFO
EXTRA_FLAGS=
