# Auto detect text files and perform LF normalization
* text=auto

# Go source files
*.go text diff=golang

# Web assets
*.js text
*.css text
*.html text

# Config
*.yaml text
*.yml text
*.json text

# Documentation
*.md text

# Binary
*.exe binary
*.png binary
*.jpg binary
*.gif binary
*.tar.gz binary

# install.sh carries a base64 archive appended after a marker line. `text=auto`
# would rewrite its line endings on checkout and corrupt the payload, so the
# extraction would fail on a fresh clone.
deploy/agy/install.sh -text

# Linguist overrides - ensure GitHub detects this as a Go project
*.js linguist-vendored
web/static/js/xterm.js linguist-vendored
web/static/js/xterm-addon-fit.js linguist-vendored
web/static/js/xterm-addon-web-links.js linguist-vendored
web/static/css/xterm.css linguist-vendored
